# ============================================================
# CLEAR ROAD — environment variables
#
# COPY THIS FILE TO .env.local AND FILL IN REAL VALUES.
# NEVER commit .env* files. No real secrets are committed.
#
# The app builds and runs without these variables set; the
# Supabase client factories resolve lazily and return null
# when configuration is missing so the UI can show a
# "Supabase not configured" state during development.
#
# All three are REQUIRED for a functioning application.
# ============================================================

# Next.js exposes NEXT_PUBLIC_* variables to the browser bundle.
# These are public by design — the anon key must never be treated
# as a secret (it is a public identifier gated by RLS/RPCs).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-ONLY. Must NEVER be exposed to the browser, never shipped
# in a client bundle, and never referenced from client code.
# Used exclusively by src/lib/supabase/admin.ts after an explicit
# "import \"server-only\"" guard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------
# Required Supabase project setup for M0B and beyond:
#   1. Enable PostGIS on the project (migrations handle it too).
#   2. Enable anonymous sign-ins:
#        Authentication -> Providers -> Allow anonymous sign-ins: ON
#   3. Apply migrations (supabase migration up or DB console).
#   4. Realtime: publication membership is created by a migration;
#      enable the Realtime add-on per project dashboard.
# ------------------------------------------------------------------
# Optional: enables Map / Satellite in the header. Restrict to your site domains.
NEXT_PUBLIC_MAPTILER_KEY=
